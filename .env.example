# --- Supabase (hosted or local) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres (optional; prefer supabase-py unless you need raw SQL)
DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres

# --- AI service ---
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
CORS_ORIGINS=http://localhost:3000
INGEST_WEBHOOK_SECRET=replace-with-long-random-secret
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Frontend ---
# The public landing page does not read this file.
# Set SUPABASE_URL and SUPABASE_ANON_KEY in app.js. Keep placeholders in git.
NEXT_PUBLIC_AI_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- n8n ---
N8N_ENCRYPTION_KEY=replace-with-32-plus-char-secret
N8N_HOST=localhost
N8N_PORT=5678
WEBHOOK_URL=http://localhost:5678/

# --- Cloudflare Worker ---
AI_ORIGIN=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
